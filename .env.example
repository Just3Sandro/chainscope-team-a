# Environnement : dev | test | prod ; prod désactive OpenAPI et le debug.
APP_ENV=dev
LOG_LEVEL=INFO
# Profil Compose de développement uniquement (active Mailpit).
COMPOSE_PROFILES=dev
POSTGRES_USER=chainscope
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chainscope
# Reporter le mot de passe choisi ci-dessus, encodé pour une URL si nécessaire.
DATABASE_URL=postgresql+psycopg://chainscope:change-me@postgres:5432/chainscope
# Chemin interne du volume privé ; jamais exposé par le frontend.
EVIDENCE_STORAGE_DIR=/var/lib/chainscope/evidences
# Vide = CORS désactivé. Sinon origines explicites séparées par des virgules ; * interdit.
CORS_ALLOWED_ORIGINS=
FRONTEND_PORT=8080
MAILPIT_UI_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025
# Proxy de npm run dev ; variable à exporter ou placer dans frontend/.env.local.
VITE_API_PROXY_TARGET=http://localhost:8000
